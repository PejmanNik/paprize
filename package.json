{
    "name": "paprize",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "build:website": "pnpm -r -F @paprize/website build",
        "build": "pnpm -r -F './packages/**' build",
        "release": "pnpm -r -F './packages/**' build && pnpm -r -F './packages/**' publish --no-git-checks --provenance --access public",
        "test": "pnpm run test:unit && pnpm run test:snapshot",
        "test:unit": "pnpm -r -F=!@paprize/snapshot-tests -F=!paprize --if-present test -- --run",
        "test:snapshot": "pnpm -r -F @paprize/snapshot-tests test",
        "coverage": "pnpm -r --if-present coverage",
        "lint": "eslint && prettier '*.{js,ts,tsx,mjs,cjs,json,html}' --check"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@eslint/js": "catalog:",
        "@microsoft/api-extractor": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-react-refresh": "catalog:",
        "globals": "catalog:",
        "prettier": "catalog:",
        "typescript-eslint": "catalog:"
    }
}
